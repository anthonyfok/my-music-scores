bb = { | \bar "'" }
bl = { | \bar "|" }
bll = { | \bar "||" }

sd = { \set melismaBusyProperties = #'() \slurDashed }
ss = { \slurSolid \unset melismaBusyProperties }

nn = \once \override Voice.Accidental.stencil = ##f

melody = \relative c' {
  \tempo "Recitativo legato"
  \global
  \autoBeamOff
  
  %\unfoldRepeats
  %d8 e fis g fis[ e] d e4 \bl  g8 a b c b[ a g] a b4 \bl d,8 e g a g[ fis e] d e4 \bll
  
  %\repeat volta 2 {
    c8 d e f e d c d4 \bl
    f8 g a bes! a[ g f] g a4 \bl
    c,8 d f g f[ e d] c d4 \bll \break
  %}
  
  %\break
  %\vspace #11
  
  c8 d e f e d c d4 \bl
    f8 g a bes! a g[ f] g a4 \bl
    c,8 d f g f e[ d] c d4 \bll \break
  
  \pageBreak
  %{b'8 d e e d[
  \once \override Voice.Accidental.stencil = ##f
  cis] d e4 \bl  d8 b d[ cis] a g[ fis] e d4 \bl  a'8 g a[ b] a g[ fis e] d e4 \bll
  %}
  \unfoldRepeats
  
    a'8 c d d c \nn b c d4 \bl
    c8 a c b g f e d c4 \bl
    g'8 f g a g f[ e] d c d4 \bll
  
  a'8 c d d c \nn b c d4 \bl
    c8 a c b[ g] f e d c4 \bl
    g'8 f g a g f[ e d] c d4 \bll
  
  \pageBreak
  %e'8 e d[ cis] d e[ d] cis b4 \bl  g8 e d e g a g4 \bl  a8[ b] c b a g[ fis e] d e4 \bll
  \unfoldRepeats
  \repeat volta 2 {
    d'8 d c[ \nn b] c d[ c] b a4 \bl
    f8 d c d f[ g] f4 \bl
    g8[ a] bes a g f[ e d] c d4 \bll
  }
  
  %{b'8 d
  \once \override Voice.Accidental.stencil = ##f
  cis[ b] cis d[ cis] b a4 \bl  b8 b g[ fis] g a[ g] fis e4 \bl  fis8 a b a d cis b4 \bll
  %}
  \unfoldRepeats
  \repeat volta 2 {
    a'8 c \nn b[ a] b c[ b] a g4 \bl  a8 a f[ e] f g[ f] e d4 \bl  e8 g a g c b a4 \bll
  }
  
  %e8 e a, b d cis b4 \bl  b8 c b[ a] b g a g4 \bl  fis8 a b e, g fis e4 \bll
  \pageBreak
  \unfoldRepeats
  \repeat volta 2 {
    d8 d g, a c \nn b a4 \bl  a8 bes a[ g] a f g f4 \bl  e8 g a d, f e d4 \bll
  }
  
  \pageTurn
  d8[ e d] c4( d) \bb  c8 f e[ d] d4 | \bar "|."
}

